<mxfile host="drawio"><diagram id="architecture" name="architecture"><mxGraphModel dx="1100" dy="670" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Air quality forecasting: feature, training and inference pipelines" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1020" height="36" as="geometry"/></mxCell>
<mxCell id="sub" value="three pipelines that never call each other, sharing only a feature store and a model registry, on odctl" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=13;fontStyle=2;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1020" height="24" as="geometry"/></mxCell>
<mxCell id="orch" value="&lt;b&gt;Airflow&lt;/b&gt;&lt;br&gt;daily run at 00:00 UTC; inference follows each daily run and each training run" style="sketch=1;fontFamily=Comic Sans MS;strokeWidth=2;html=1;rounded=1;whiteSpace=wrap;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250" y="95" width="600" height="50" as="geometry"/></mxCell>
<mxCell id="sources" value="&lt;b&gt;Simulated data&lt;/b&gt;&lt;br&gt;dynamic-des: hourly weather forecasts and PM2.5 readings" style="sketch=1;fontFamily=Comic Sans MS;strokeWidth=2;html=1;rounded=1;whiteSpace=wrap;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="170" height="80" as="geometry"/></mxCell>
